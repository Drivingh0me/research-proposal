  shorttitle = {Organic Solar Cells},
  author = {Ma, Ruijie and Luo, Zhenghui and Zhang, Youdi and Zhan, Lingling and Jia, Tao and Cheng, Pei and Yan, Cenqi and Fan, Qunping and Liu, Shengjian and Ye, Long and Zhang, Guangye and Xu, Xiaopeng and Gao, Wei and Wu, Yue and Wu, Jiaying and Li, Yuxiang and Liu, Yuhang and Liu, Feng and Song, Jiali and Chen, Haiyang and Chen, Weijie and Zhang, Xin and Liu, Yahui and Yuan, Jun and Liu, Quan and Kan, Zhipeng and Yin, Hang and Li, Xiaojun and Ma, Yunlong and Deng, Dan and Zhu, Lei and Huo, Yong and Fan, Baobin and Fu, Huiting and Liao, Xunfan and Hu, Hanlin and Li, Chao and Yu, Runnan and Hu, Huawei and Yao, Zhaoyang and Cai, Yunhao and Qian, Deping and Cui, Yong and Yao, Huifeng and Xu, Bowei and Kan, Bin and Gao, Ke and Duan, Chunhui and Hu, Xiaotian and Sun, Huiliang},
